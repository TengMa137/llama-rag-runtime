{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-dev",
      "displayName": "macOS development",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LRS_BUILD_LLAMA_SERVER": "ON",
        "LRS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a mobile RAG library",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "LRS_BUILD_COORDINATOR": "OFF",
        "LRS_BUILD_LLAMA_SERVER": "OFF",
        "LRS_BUILD_MOBILE": "ON",
        "LRS_BUILD_MOBILE_SMOKE": "ON",
        "LRS_BUILD_SPEC_CHECK": "OFF",
        "LRS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-dev", "configurePreset": "macos-dev" },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": ["lrs_mobile"]
    }
  ],
  "testPresets": [
    {
      "name": "macos-dev",
      "configurePreset": "macos-dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
