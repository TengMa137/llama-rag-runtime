{
  "listen": { "host": "127.0.0.1", "port": 8080 },
  "retrieval": {
    "backend": "postgres",
    "postgres": {
      "connection_env": "LRS_POSTGRES_URL",
      "schema": "lrs_rag",
      "corpus": "default",
      "pool_size": 4,
      "acquire_timeout_ms": 5000,
      "statement_timeout_ms": 10000,
      "vector_index": "exact",
      "hnsw_ef_search": 64
    }
  },
  "ingestion": { "workers": 1, "queue_capacity": 64 },
  "inference": {
    "spawn": false,
    "embedding": {
      "host": "127.0.0.1",
      "port": 8081,
      "api_model": "granite-embedding",
      "pooling": "mean",
      "dimension": 384
    },
    "generation": {
      "host": "127.0.0.1",
      "port": 8082,
      "api_model": "qwen-generation",
      "context_size": 8192
    }
  },
  "rag": { "context_tokens": 6144 }
}
